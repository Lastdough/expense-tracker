// Dev/local schema. Uses the better-sqlite3 driver adapter at runtime.
// Wired through container.ts. Migrations live alongside in ./migrations/.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// ── Categorization context ──────────────────────────────────────────────────
// Reference data for expenses. Archive, never delete — historical expenses
// continue to reference these rows by id. See CLAUDE.md "Reference data uses
// archive, not delete".
//
// `nameNormalized` carries the lowercased version for the unique index;
// `name` keeps the original casing the user typed.

model Category {
  id             String  @id
  name           String
  nameNormalized String  @unique
  bgColor        String
  textColor      String
  isArchived     Boolean @default(false)
  displayOrder   Int

  expenses Expense[]

  @@index([displayOrder])
}

model Method {
  id             String  @id
  name           String
  nameNormalized String  @unique
  bgColor        String
  textColor      String
  isArchived     Boolean @default(false)
  displayOrder   Int

  expenses Expense[]

  @@index([displayOrder])
}

model ReimbursementStatus {
  id             String  @id
  name           String
  nameNormalized String  @unique
  bgColor        String
  textColor      String
  isArchived     Boolean @default(false)
  displayOrder   Int
  // Stable discriminator the reimbursements context maps to a
  // ReimbursementState variant. Immutable after creation.
  kind           String  @default("NonReimbursable")

  expenses Expense[]

  @@index([displayOrder])
}

// ── Expenses context ────────────────────────────────────────────────────────
// The daily-driver aggregate. `amountMinor` is a 64-bit integer in the
// currency's minor units (Money VO is the source of truth at the app layer);
// `currency` is hard-coded to 'IDR' today but persisted per row so a future
// Settings flow can introduce per-user currency without migration.
// `rawInput` keeps the formula the user typed (e.g. "=20000*5") when the
// amount came from a formula; null when the user typed a plain number.

model Expense {
  id                    String   @id
  transactionDate       DateTime
  amountMinor           BigInt
  currency              String
  rawInput              String?
  description           String
  categoryId            String
  methodId              String
  reimbursementStatusId String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  category            Category            @relation(fields: [categoryId], references: [id])
  method              Method              @relation(fields: [methodId], references: [id])
  reimbursementStatus ReimbursementStatus @relation(fields: [reimbursementStatusId], references: [id])
  reimbursement       Reimbursement?

  @@index([transactionDate])
  @@index([categoryId])
  @@index([methodId])
  @@index([reimbursementStatusId])
}

// ── Reimbursements context ──────────────────────────────────────────────────
// One Reimbursement per Expense (unique on expenseId). `kind` is the
// discriminator for the state machine VO; `paidAt` / `receivedAt` carry the
// only state-dependent payload. Cascade on delete is defense in depth —
// the DeleteReimbursementOnExpenseDeleted handler is the primary path.

model Reimbursement {
  id         String    @id
  expenseId  String    @unique
  kind       String
  paidAt     DateTime?
  receivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@index([kind])
}
