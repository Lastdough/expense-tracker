// Dev/local schema. Uses the better-sqlite3 driver adapter at runtime.
// Wired through container.ts. Migrations live alongside in ./migrations/.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// Throwaway placeholder for Milestone C. Proves the wiring
// Controller -> UseCase -> Repository -> Prisma -> real DB read.
// Will be removed when the real Expense aggregate lands in Milestone F.
model Ping {
  id         String   @id
  message    String
  recordedAt DateTime @default(now())
}

// ── Categorization context ──────────────────────────────────────────────────
// Reference data for expenses. Archive, never delete — historical expenses
// continue to reference these rows by id. See CLAUDE.md "Reference data uses
// archive, not delete".
//
// `nameNormalized` carries the lowercased version for the unique index;
// `name` keeps the original casing the user typed.

model Category {
  id             String  @id
  name           String
  nameNormalized String  @unique
  bgColor        String
  textColor      String
  isArchived     Boolean @default(false)
  displayOrder   Int

  @@index([displayOrder])
}

model Method {
  id             String  @id
  name           String
  nameNormalized String  @unique
  bgColor        String
  textColor      String
  isArchived     Boolean @default(false)
  displayOrder   Int

  @@index([displayOrder])
}

model ReimbursementStatus {
  id             String  @id
  name           String
  nameNormalized String  @unique
  bgColor        String
  textColor      String
  isArchived     Boolean @default(false)
  displayOrder   Int

  @@index([displayOrder])
}
