// Production schema. Kept structurally identical to the SQLite schema —
// when the two drift, that's a bug. Migrations live alongside in ./migrations/.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── Categorization context ──────────────────────────────────────────────────

model Category {
  id             String  @id
  name           String
  nameNormalized String  @unique
  bgColor        String
  textColor      String
  isArchived     Boolean @default(false)
  displayOrder   Int

  expenses Expense[]

  @@index([displayOrder])
}

model Method {
  id             String  @id
  name           String
  nameNormalized String  @unique
  bgColor        String
  textColor      String
  isArchived     Boolean @default(false)
  displayOrder   Int

  expenses Expense[]

  @@index([displayOrder])
}

model ReimbursementStatus {
  id             String  @id
  name           String
  nameNormalized String  @unique
  bgColor        String
  textColor      String
  isArchived     Boolean @default(false)
  displayOrder   Int

  expenses Expense[]

  @@index([displayOrder])
}

// ── Expenses context ────────────────────────────────────────────────────────

model Expense {
  id                    String   @id
  transactionDate       DateTime
  amountMinor           BigInt
  currency              String
  rawInput              String?
  description           String
  categoryId            String
  methodId              String
  reimbursementStatusId String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  category            Category            @relation(fields: [categoryId], references: [id])
  method              Method              @relation(fields: [methodId], references: [id])
  reimbursementStatus ReimbursementStatus @relation(fields: [reimbursementStatusId], references: [id])

  @@index([transactionDate])
  @@index([categoryId])
  @@index([methodId])
  @@index([reimbursementStatusId])
}
