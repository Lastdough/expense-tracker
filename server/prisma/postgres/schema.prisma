// Production schema. Kept structurally identical to the SQLite schema —
// when the two drift, that's a bug. Migrations live alongside in ./migrations/.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Ping {
  id         String   @id
  message    String
  recordedAt DateTime @default(now())
}

// ── Categorization context ──────────────────────────────────────────────────

model Category {
  id             String  @id
  name           String
  nameNormalized String  @unique
  bgColor        String
  textColor      String
  isArchived     Boolean @default(false)
  displayOrder   Int

  @@index([displayOrder])
}

model Method {
  id             String  @id
  name           String
  nameNormalized String  @unique
  bgColor        String
  textColor      String
  isArchived     Boolean @default(false)
  displayOrder   Int

  @@index([displayOrder])
}

model ReimbursementStatus {
  id             String  @id
  name           String
  nameNormalized String  @unique
  bgColor        String
  textColor      String
  isArchived     Boolean @default(false)
  displayOrder   Int

  @@index([displayOrder])
}
