# Copy to server/.env and adjust as needed.

# HTTP port the Express server listens on.
PORT=3000

# One of: development | production | test
NODE_ENV=development

# Monolith mode: when true (and NODE_ENV=production), Express also serves
# the built React app from client/dist. Leave false in decoupled deploys.
SERVE_FRONTEND=false

# Comma-separated allowed origins for CORS in production.
# Ignored in development (all origins are allowed in dev).
# Example: CORS_ORIGINS=https://app.example.com,https://www.example.com
CORS_ORIGINS=
