# Source control
.git
.gitignore
.gitattributes

# Editor / OS
.vscode
.idea
.DS_Store

# Local environment
.env
.env.*
!.env.example
server/.env
server/.env.*
!server/.env.example

# Local databases — never bake into an image
server/**/*.db
server/**/*.db-journal

# Build artifacts (regenerated inside the image)
**/node_modules
**/dist
**/build
**/coverage
**/*.tsbuildinfo

# Logs and runtime junk
**/*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*

# Claude Code local settings
.claude
