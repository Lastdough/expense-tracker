server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  # API requests are reverse-proxied to the backend container. The frontend
  # can therefore use a relative '/api/...' URL and never deal with CORS.
  location /api/ {
    proxy_pass ${API_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # SPA fallback — React Router owns paths the server doesn't have files for.
  location / {
    try_files $uri $uri/ /index.html;
  }

  # Cache hashed static assets aggressively.
  location ~* \.(js|css|woff2?|ttf|eot|svg|png|jpg|jpeg|gif|webp|ico)$ {
    expires 1y;
    add_header Cache-Control "public, immutable";
    try_files $uri =404;
  }

  # Don't cache index.html — it references hashed assets and must be fresh.
  location = /index.html {
    add_header Cache-Control "no-store";
  }
}
